# OhmZ Service Probes v1.0
# Parsed at compile time via @embedFile - zero runtime cost.
#
# Format: name|type|pattern|version_skip
#   type: p = prefix match, c = contains match
#   version_skip: N = skip N bytes from match start, extract to CRLF
#                 -1 = no version extraction
#
# Sections:
#   [null]  - matched against NULL probe response (services that speak first)
#   [http]  - matched against full HTTP GET response (headers + body)
#
# Lines starting with # and empty lines are ignored.
# Signatures are tried in file order; first match wins.

[null]
# Standard protocols not covered by classifyBanner
POP3|p|+OK |4
IMAP|p|* OK |-1
VNC|p|RFB |4
NATS|p|INFO {|-1
Rsync|p|@RSYNCD: |9

[http]
# Header-based detection
Jenkins|c|X-Jenkins:|-1
Kibana|c|kbn-name|-1
# Title-based detection - common self-hosted services
